// 历史内存版组件，已由 MVVM 组件替代。
import 'dart:ui';

import 'package:flutter/material.dart';
import 'package:work_time_tracker/core/utils/time_formatters.dart';
import 'package:work_time_tracker/domain/entities/work_subtask.dart';
import 'package:work_time_tracker/domain/entities/work_task.dart';
import 'package:work_time_tracker/l10n/app_localizations.dart';

class TaskSummaryHeader extends StatelessWidget {
  const TaskSummaryHeader({
    required this.task,
    required this.currentTime,
    super.key,
  });

  final WorkTask task;
  final DateTime currentTime;

  @override
  Widget build(BuildContext context) {
    final AppLocalizations localizations = AppLocalizations.of(context);
    final int trackedSubtaskCount = task.subtasks.where(
      (WorkSubtask subtask) {
        return subtask.getElapsedSeconds(currentTime) > 0;
      },
    ).length;
    return Container(
      width: double.infinity,
      padding: const EdgeInsets.all(24),
      decoration: BoxDecoration(
        color: Colors.white,
        borderRadius: BorderRadius.circular(18),
        border: Border.all(color: const Color(0xFFE6E8F0)),
      ),
      child: Wrap(
        spacing: 32,
        runSpacing: 18,
        alignment: WrapAlignment.spaceBetween,
        crossAxisAlignment: WrapCrossAlignment.center,
        children: <Widget>[
          _buildTitle(context, localizations),
          _buildTotalTime(context, localizations, trackedSubtaskCount),
        ],
      ),
    );
  }

  Widget _buildTitle(
    BuildContext context,
    AppLocalizations localizations,
  ) {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: <Widget>[
        Text(
          localizations.taskOverview,
          style: Theme.of(context).textTheme.bodySmall?.copyWith(
                color: const Color(0xFF85899A),
                fontWeight: FontWeight.w600,
              ),
        ),
        const SizedBox(height: 7),
        Row(
          mainAxisSize: MainAxisSize.min,
          children: <Widget>[
            Container(
              width: 12,
              height: 12,
              decoration: BoxDecoration(
                color: Color(task.colorValue),
                shape: BoxShape.circle,
              ),
            ),
            const SizedBox(width: 10),
            Text(
              task.title,
              style: Theme.of(context).textTheme.headlineSmall?.copyWith(
                    fontWeight: FontWeight.w700,
                  ),
            ),
          ],
        ),
        const SizedBox(height: 7),
        Semantics(
          identifier: 'workTimeTrackerPage.selectedTaskCreatedAt.${task.id}', // 自动化测试用标识：当前主任务创建日期
          child: Text(
            localizations.createdOn(formatDate(task.createdAt)),
            style: Theme.of(context).textTheme.bodySmall?.copyWith(
                  color: const Color(0xFF85899A),
                ),
          ),
        ),
      ],
    );
  }

  Widget _buildTotalTime(
    BuildContext context,
    AppLocalizations localizations,
    int trackedSubtaskCount,
  ) {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.end,
      children: <Widget>[
        Text(
          localizations.totalTime,
          style: Theme.of(context).textTheme.bodySmall?.copyWith(
                color: const Color(0xFF85899A),
              ),
        ),
        const SizedBox(height: 4),
        Text(
          formatDuration(task.getTotalSeconds(currentTime)),
          style: Theme.of(context).textTheme.headlineMedium?.copyWith(
                color: Color(task.colorValue),
                fontWeight: FontWeight.w800,
                fontFeatures: const <FontFeature>[FontFeature.tabularFigures()],
              ),
        ),
        Text(
          localizations.taskProgress(trackedSubtaskCount, task.subtasks.length),
          style: Theme.of(context).textTheme.bodySmall?.copyWith(
                color: const Color(0xFF85899A),
              ),
        ),
      ],
    );
  }
}
